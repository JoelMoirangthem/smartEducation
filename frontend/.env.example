# SmartEducation Frontend Environment Variables
# Copy this file to .env and adjust if needed.

# ── Development (default) ──
# Leave empty to use Vite dev proxy (/api -> localhost:5000 + /api/v1/agent -> 8000)
VITE_API_URL=

# ── Production (Render / Vercel) ──
# For split deploy (Vercel frontend + Render backend): set absolute backend URL
# VITE_API_URL=https://edusmart-backend.onrender.com/api/v1
# For single-service Render (backend serves frontend/dist), keep empty (relative /api/v1)
# VITE_API_URL=/api/v1