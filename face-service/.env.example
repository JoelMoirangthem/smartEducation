# SmartEducation Face Service Environment Variables
# Copy this file to .env and fill in the values.

# Fernet encryption key - MUST be 44-char padded url-safe base64 (32 bytes).
# Generate with: python generate_key.py  (or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
EMBEDDING_ENCRYPTION_KEY=

# File where face embeddings are persisted
EMBEDDINGS_FILE=embeddings.pkl

# Port for the Flask service
FLASK_PORT=5001

# Recognition threshold (Euclidean distance). Lower = stricter.
# Facenet default recommendation: ~0.68
FACE_THRESHOLD=0.68

# Minimum confidence % required to accept a match (0-100)
MIN_CONFIDENCE=35