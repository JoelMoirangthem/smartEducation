# SmartEducation Backend Environment Variables
# Copy this file to .env and fill in the values.

PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/attendance_db  (or 27018 if you run ./scripts with --port 27018)
# Atlas FREE: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/attendance_db
# IMPORTANT: If password contains @, encode as %40 (e.g., "my@pass" → "my%40pass")
MONGODB_URI=mongodb://localhost:27017/attendance_db

# Python Face Service — set empty on free hosting to disable (QR only) and save RAM
# Local: http://localhost:5001  Prod (if enabled): https://edusmart-face.onrender.com
PYTHON_SERVICE_URL=http://localhost:5001

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# AI Configuration — Primary: AgentRouter (agentic), then Sarvam (fast), then NVIDIA (reasoning)
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=gpt-5.6-sol
AGENTROUTER_USER_AGENT=opencode/1.0.0

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b

SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_API_KEY=
AGENT_MODEL=sarvam-105b-conversations
ASSISTANT_MODEL=sarvam-105b-conversations

# Agent service URL — local: http://127.0.0.1:8000, prod: https://edusmart-agent.onrender.com
AGENT_PY_URL=http://127.0.0.1:8000
AGENT_PY_HOST=127.0.0.1
AGENT_PY_PORT=8000

# Shared secret the Python agent uses to push socket events via /api/v1/internal/emit
AGENT_RELAY_SECRET=agent-relay-dev-secret
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS=16384
# Note: reasoning models use tokens for both thinking and output,
# so effective output is roughly half of max_tokens.
AGENT_TIMEOUT_MS=180000
AGENT_APPROVAL_TTL_MIN=15

# Allowed origins for CORS (comma separated)
# Local: http://localhost:5173,http://127.0.0.1:5173
# Prod (Render + Vercel): https://edusmart-frontend.onrender.com,https://edusmart-backend.onrender.com,https://your-vercel.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary (optional, for avatar uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public self-registration for students/teachers (admin is always bootstrap-only)
ALLOW_PUBLIC_REGISTRATION=false
